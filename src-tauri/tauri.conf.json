{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swarm Command Center",
  "version": "0.1.0",
  "identifier": "dev.swarm.commandcenter",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Swarm Command Center",
        "width": 1320,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Hybrid multi-agent command center",
    "longDescription": "Architect + coder agent loop that plans, generates, reviews and writes code into a local project. Works with cloud APIs or local IDE/CLI bridges."
  }
}
